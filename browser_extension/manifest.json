{
  "manifest_version": 3,
  "name": "DISO",
  "version": "1.7",
  "version_name": "1.7",
  "description": "__MSG_description__",
  "default_locale": "en",
  "key": "",
  "permissions": ["contextMenus", "downloads", "storage", "cookies", "activeTab", "scripting", "nativeMessaging", "webRequest"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*", "<all_urls>"],
  "background": {
    "service_worker": "sw.js"
  },
  "action": {
    "default_title": "DISO",
    "default_popup": "popup.html",
    "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}
  },
  "options_ui": {"page": "options.html", "open_in_tab": true},
  "content_scripts": [{"matches": ["<all_urls>"], "js": ["catch.js"], "run_at": "document_start", "all_frames": true},
                      {"matches": ["<all_urls>"], "js": ["sniff.js"], "run_at": "document_start", "all_frames": true,
                       "world": "MAIN"}],
  "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}
}
